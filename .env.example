PROCEDURE_SERVICE_URL=http://procedure-service:8000
USER_SERVICE_URL=http://user-service:8000
LAWYER_SERVICE_URL=http://lawyer-service:8000
AGENT_SERVICE_URL=http://agent-service:8000
RAG_SERVICE_URL=http://rag-service:8000
CONTRACT_SERVICE_URL=http://contract-service:8000
DOCUMENT_SERVICE_URL=http://document-service:8000
LOCATION_SERVICE_URL=http://location-service:8000
CONSULTATION_SERVICE_URL=http://consultation-service:8000
NOTIFICATION_SERVICE_URL=http://notification-service:8000

# Database ownership: one connection setting per service.
AGENT_DATABASE_URL=
# Dùng pooler transaction cổng 6543 (pooler session 5432 chỉ 15 kết nối, cả nhóm dùng chung là hết → login lỗi 500).
USER_DATABASE_URL=
LAWYER_DATABASE_URL=
PROCEDURE_DATABASE_URL=
RAG_DATABASE_URL=
# rag-service chống treo khi kết nối DB chết ngầm (giây, 0 = bỏ giới hạn): chờ tối đa khi mở kết nối mới / cho một truy vấn,
# và tuổi tối đa của kết nối trong pool. Truy vấn quá giờ thì rag trả 503 nhanh thay vì treo. Chạy script nạp văn bản
# (ingest) mà có câu SQL lâu hơn DB_COMMAND_TIMEOUT_SECONDS thì đặt 0.
DB_CONNECT_TIMEOUT_SECONDS=10
DB_COMMAND_TIMEOUT_SECONDS=20
DB_POOL_RECYCLE_SECONDS=300
CONTRACT_DATABASE_URL=
CONTRACT_SUPABASE_URL=
CONTRACT_SUPABASE_SERVICE_ROLE_KEY=
CONTRACT_STORAGE_BUCKET=contract-files
# Exact trusted frontend origins for Contract cookie-authenticated writes.
CONTRACT_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DOCUMENT_DATABASE_URL=
LOCATION_DATABASE_URL=
CONSULTATION_DATABASE_URL=
# Phiên bản điều khoản chat với luật sư; đổi giá trị thì mọi user phải đồng ý lại.
CONSULTATION_TERMS_VERSION=2026-11-01
# Origin frontend được dùng cookie mở WebSocket chat; deploy thì thêm domain FE.
CONSULTATION_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NOTIFICATION_DATABASE_URL=

# Location search is opt-in. Keep the real Goong key only in ignored .env.
GOONG_API_KEY=
LOCATION_SEARCH_ENABLED=false
LOCATION_GOONG_TIMEOUT_SECONDS=5
LOCATION_SEARCH_TIMEOUT_SECONDS=20
LOCATION_GOONG_MAX_RPS=4
LOCATION_GOONG_DAILY_BUDGET=1000

# Optional Google Search grounding for office hotline/reception hours (backend only).
# Uses GEMINI_API_KEY. Requires model supporting google_search and available quota.
# GOOGLE_MAPS_API_KEY enables exact-address Google Places opening hours first;
# the official website lookup remains the fallback when no matching Place exists.
GOOGLE_MAPS_API_KEY=
LOCATION_WEB_LOOKUP_ENABLED=false
LOCATION_WEB_MODEL=gemini-2.5-flash
LOCATION_WEB_DAILY_BUDGET=20

# Configure these per service when Supabase is used.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# procedure-service: khoá anon (public) của project Supabase, không có giá trị mặc định trong docker-compose.yml
SUPABASE_ANON_KEY=<lấy từ Supabase, mục API>
# Document Storage uses its own project, independently of other services.
DOCUMENT_SUPABASE_URL=
DOCUMENT_SUPABASE_SERVICE_ROLE_KEY=
DOCUMENT_STORAGE_BUCKET=document-files
# Optional Session pooler host from Connect; setup script reuses DOCUMENT_DATABASE_URL credentials.
DOCUMENT_DATABASE_POOLER_HOST=
DOCUMENT_HTTP_TIMEOUT_SECONDS=20
# Trusted exact origins for cookie-authenticated mutations; keep aligned with Gateway.
DOCUMENT_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Local Tesseract 5 CPU, pretrained vie+eng models installed in the Docker image.
DOCUMENT_OCR_MODEL_DIR=/usr/share/tesseract-ocr/5/tessdata
DOCUMENT_OCR_CPU_THREADS=2
DOCUMENT_VIETOCR_ENABLED=1
DOCUMENT_VIETOCR_MODEL_DIR=/opt/vietocr
# Document upload/CCCD OCR/profile PUT require the User internal status API.
# USER_SERVICE_URL and INTERNAL_TOKEN must match User Service; no bypass on error.

# T6 opt-in worker: API/CCCD T4 does not need these settings.
DOCUMENT_PADDLE_MODEL_DIR=/opt/document-ocr
DOCUMENT_PROCESSING_TIMEOUT_SECONDS=240
DOCUMENT_CLAMAV_HOST=document-antivirus
DOCUMENT_CLAMAV_PORT=3310
# T7 delivery stays disabled until Notification's internal receiver is implemented.
DOCUMENT_NOTIFICATIONS_ENABLED=false
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/

# Khóa cho API nội bộ /internal/v1/... (service gọi service, header X-Internal-Token).
# Đặt một chuỗi ngẫu nhiên dài, mọi service dùng chung giá trị này.
INTERNAL_TOKEN=

# Khóa riêng cho PUT /internal/v1/users/{user_id}/role (Lawyer Service -> User Service đổi vai trò sang lawyer).
# Chỉ user-service và lawyer-service dùng; KHÁC INTERNAL_TOKEN. Để trống thì route trả 503.
LAWYER_SERVICE_TOKEN=

# JWT (RS256). Key nằm NGOÀI repo, không commit file .pem.
# Chạy bằng Docker: thư mục chứa jwt_public.pem và jwt_private.pem.
JWT_KEYS_DIR=
# Chạy local bằng uvicorn: đường dẫn tới từng file key.
JWT_PUBLIC_KEY_PATH=
JWT_PRIVATE_KEY_PATH=

# HttpOnly cookie cho access/refresh token (user-service), chạy song song với Bearer.
# Local qua gateway: để mặc định. Deploy HTTPS: AUTH_COOKIE_SECURE=true.
# FE và BE khác domain (vd. vercel.app vs onrender.com): AUTH_COOKIE_SAMESITE=none (tự bật Secure).
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_DOMAIN=
AUTH_REFRESH_COOKIE_PATH=/api

# Firebase Authentication (user-service kiểm tra Firebase ID token). Không phải bí mật.
FIREBASE_PROJECT_ID=
# Số giây cho phép lệch giờ khi kiểm tra Firebase ID token (0-60, mặc định 10).
FIREBASE_CLOCK_SKEW_SECONDS=10

# VNPT eKYC: EKYC_ENABLED=1 thì đọc CCCD bằng VNPT trước (tính phí theo lượt); VNPT lỗi
# (token hết hạn, hết lượt, mạng) hoặc đọc không đủ thì tự dùng OCR local ở trên.
# Lấy 3 token ở console ekyc.vnpt.vn; access token có hạn (~1 ngày).
EKYC_ENABLED=0
EKYC_ACCESS_TOKEN=
EKYC_PROVIDER=vnpt
EKYC_BASE_URL=https://api.idg.vnpt.vn
EKYC_TOKEN_ID=
EKYC_TOKEN=
EKYC_VALIDATION_ENABLED=false

# Agent-service LLM: OpenRouter trước, lỗi thì tự chuyển sang Gemini.
# Khóa lấy tại https://openrouter.ai/keys (KHÔNG commit khóa thật).
LLM_PROVIDER=openrouter,gemini
# Chỉ để test, KHÔNG bật ở môi trường thật: true = agent bỏ bước LLM, trả thẳng các đoạn luật rag tìm được.
LLM_BYPASS=false
# true = trước khi trả lời, nhờ LLM chấm xem các đoạn luật tìm được có liên quan không; không liên quan thì trả câu "ngoài phạm vi".
# Mỗi câu hỏi tốn thêm một lượt gọi LLM ngắn (chờ tối đa RELEVANCE_TIMEOUT_SECONDS giây, quá giờ thì bỏ qua bước chấm).
RELEVANCE_CHECK=false
RELEVANCE_TIMEOUT_SECONDS=8
# Số ký tự đầu của mỗi đoạn luật mà bước chấm liên quan được đọc (đoạn luật dài tới ~2500 ký tự). Tăng thì prompt chấm dài và chậm hơn.
RELEVANCE_CHUNK_CHARS=600
# true = viết lại câu hỏi thành một câu tìm kiếm dùng thuật ngữ luật (nhờ LLM) trước khi tìm trong rag-service. Mỗi câu hỏi tốn thêm
# một lượt gọi LLM ngắn (chờ tối đa QUERY_REWRITE_TIMEOUT_SECONDS giây, lỗi hoặc quá giờ thì dùng câu gốc).
QUERY_REWRITE_ENABLED=false
QUERY_REWRITE_TIMEOUT_SECONDS=5
# Tìm 2 bước (cần RELEVANCE_CHECK=true, LLM_BYPASS=false): lấy RAG_CANDIDATE_K đoạn luật làm ứng viên (lớn hơn RAG_TOP_K, tối đa 20)
# rồi AI chấm chọn đoạn dùng được, giữ tối đa RAG_SELECT_MAX đoạn. RAG_CANDIDATE_K=0 là tắt. Không thêm lượt gọi LLM.
RAG_CANDIDATE_K=0
RAG_SELECT_MAX=5
# true = cache kết quả tìm luật trong bộ nhớ agent-service: cùng câu tìm (không phân biệt hoa thường, khoảng trắng, dấu ? . ! ở cuối) và
# cùng RAG_TOP_K thì lấy lại, khỏi tốn một lượt embedding Gemini ở rag-service. Cache theo từng process, mất khi restart.
# Nạp luật mới xong phải restart agent-service để xoá cache (không thì tới hết TTL vẫn trả đoạn cũ).
RAG_CACHE_ENABLED=false
RAG_CACHE_TTL_SECONDS=86400
RAG_CACHE_MAX_ITEMS=1000
# true = cache câu trả lời cuối trong bộ nhớ agent-service: CHỈ câu đầu hội thoại (không có lịch sử), không kèm tài liệu, LLM_BYPASS tắt,
# và chỉ khớp khi giống hệt sau chuẩn hoá (không phân biệt hoa thường, khoảng trắng, dấu ? . ! ở cuối). Trúng thì không gọi rag và AI.
# Cache theo từng process, mất khi restart. Đổi prompt hoặc model thì restart để xoá.
ANSWER_CACHE_ENABLED=false
ANSWER_CACHE_TTL_SECONDS=21600
ANSWER_CACHE_MAX_ITEMS=500
# true = tài liệu đính kèm quá ít chữ hoặc chữ rác (OCR hỏng) thì agent trả lời ngay, không tìm luật và không gọi LLM.
# DOCUMENT_MIN_CHARS: số ký tự tối thiểu; DOCUMENT_MIN_VALID_RATIO: tỷ lệ tối thiểu các từ là âm tiết tiếng Việt hợp lệ.
DOCUMENT_GATE_ENABLED=false
DOCUMENT_MIN_CHARS=200
DOCUMENT_MIN_VALID_RATIO=0.5
# true = agent tự đếm chỗ trống ("......") và kiểm tra tài liệu có bị cắt vì quá dài không, đưa kết quả vào prompt rà soát
# để AI nêu lại cho người dùng. DOCUMENT_PLACEHOLDER_MIN: từ chừng này chỗ trống trở lên thì coi là mẫu chưa điền.
DOCUMENT_FACTS_ENABLED=false
DOCUMENT_PLACEHOLDER_MIN=5
# true = không nhận ra loại hợp đồng mà câu hỏi chung chung ("kiểm tra giúp tôi") thì agent hỏi lại người dùng loại hợp đồng
# hoặc điều cần kiểm tra, không tìm luật và không gọi LLM. Câu hỏi cụ thể hoặc loại nhận ra được thì rà soát như cũ.
DOCUMENT_ASK_TYPE_ENABLED=false
# true = agent kiểm bằng từ khoá các mục thường gặp của hợp đồng (bên, giá, thời hạn, quyền nghĩa vụ, vi phạm, tranh chấp, chữ ký)
# và đưa mục chưa thấy từ khoá vào prompt rà soát như dữ kiện cho AI nêu lại. Không khẳng định "thiếu", không gọi thêm LLM.
DOCUMENT_CHECKLIST_ENABLED=false
# Mức suy luận (OpenRouter) riêng cho lượt gọi phụ chỉ trả JSON ngắn, hiện là lượt chấm liên quan ở trên.
# 0 = tắt suy luận (chấm từ ~5s còn ~1s); số dương = chừa chừng đó token cho model bắt buộc suy luận.
LLM_AUX_REASONING_MAX_TOKENS=0
# Model OpenRouter riêng cho lượt gọi phụ (chấm liên quan, viết lại câu hỏi), thường là bản nhẹ hơn cùng họ với OPENROUTER_MODEL.
# Rỗng = lượt phụ dùng OPENROUTER_MODEL. Chỉ tác dụng với provider openrouter. Đo lại bước chấm (scripts/eval_relevance.py) trước khi dùng thật.
OPENROUTER_AUX_MODEL=
# Model cho biên bản hội thoại user - luật sư (Agent). Rỗng = OPENROUTER_MODEL. Gợi ý: google/gemini-2.5-flash
MINUTES_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=
# Token chừa cho phần "suy nghĩ" của câu trả lời chính. Mặc định 0 = không gửi tham số reasoning, hợp với model không bắt buộc
# suy nghĩ như Gemini. Model suy luận bắt buộc (vd recursive/flint-v1.0:free) cần đặt lại khoảng 1024, để 0 thì câu trả lời có thể
# bị cắt hoặc rỗng. Lượt gọi phụ có mức riêng: LLM_AUX_REASONING_MAX_TOKENS ở trên
OPENROUTER_REASONING_MAX_TOKENS=0

# ==============================================================================
# ONLYOFFICE DOCUMENT SERVER & FORM TEMPLATES
# ==============================================================================
# Khoá bí mật JWT giữa procedure-service và OnlyOffice Document Server (tối thiểu 32 ký tự ngẫu nhiên).
# Chỉ cần đặt ONLYOFFICE_JWT_SECRET ở đây, docker-compose tự map sang JWT_SECRET cho container OnlyOffice.
ONLYOFFICE_JWT_SECRET=
ONLYOFFICE_INTERNAL_URL=http://onlyoffice
ONLYOFFICE_PUBLIC_URL=http://localhost:8082
ONLYOFFICE_CALLBACK_BASE=http://procedure-service:8000/api/v1/procedures
ONLYOFFICE_BACKUP_DIR=/app/office-backups

