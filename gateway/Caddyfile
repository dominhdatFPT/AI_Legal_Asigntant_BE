# Reverse proxy cho docker-compose.ec2.yml. Đường dẫn công khai giống gateway/nginx.conf:
# /api/<x>/... -> /api/v1/<x>/...,  /ws/consultations/... -> /ws/v1/consultations/...
# Chưa có giới hạn tần suất (nginx có): Caddy bản chuẩn không kèm module rate limit.
{
	admin off
}

# Healthcheck nội bộ, không publish ra ngoài.
http://:2020 {
	respond /health "ok" 200
}

(upstream) {
	reverse_proxy {args[0]}:8000 {
		# agent-service tính hạn mức theo X-Real-IP: phải ghi đè giá trị client tự gửi.
		header_up X-Real-IP {remote_host}
		header_up -CF-Connecting-IP
		# CORS do Caddy đặt; bỏ header của service để không bị trùng.
		header_down -Access-Control-Allow-Origin
		header_down -Access-Control-Allow-Methods
		header_down -Access-Control-Allow-Headers
		header_down -Access-Control-Allow-Credentials
	}
}

# args: tên matcher, đường dẫn sau /api/, service
(api) {
	@{args[0]} path /api/{args[1]} /api/{args[1]}/*
	handle @{args[0]} {
		uri path_regexp ^/api/ /api/v1/
		# Bỏ "/" cuối ở route gốc: tránh FastAPI redirect ra đường dẫn nội bộ /api/v1/...
		uri path_regexp ^(/api/v1/(?:agent|agent/chat|users|users/auth/[a-z]+|lawyers|procedures|rag|contracts|locations|consultations|notifications|reports|admin/reports|admin/broadcasts))/$ $1
		import upstream {args[2]}
	}
}

{$SITE_ADDRESS:localhost} {
	header {
		Permissions-Policy "unload=*"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
	# Không gửi HSTS cho localhost: trình duyệt sẽ ép luôn cả frontend dev http://localhost:3000 sang https.
	@public not host localhost 127.0.0.1
	header @public Strict-Transport-Security "max-age=31536000"

	# Giữ X-Request-ID của client nếu hợp lệ, không thì sinh mới.
	@no_request_id not header_regexp X-Request-ID ^[A-Za-z0-9._:-]{1,128}$
	request_header @no_request_id X-Request-ID {http.request.uuid}

	@cors {
		header Origin {$FRONTEND_ORIGIN:http://localhost:3000}
		header Origin http://localhost:3000
		header Origin http://127.0.0.1:3000
	}
	header @cors {
		Access-Control-Allow-Origin {http.request.header.Origin}
		Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS"
		Access-Control-Allow-Headers "Content-Type, Authorization, X-Request-ID, Idempotency-Key"
		Access-Control-Allow-Credentials "true"
		Access-Control-Expose-Headers "X-Request-ID, Content-Disposition, X-Content-SHA256"
		Vary "Origin"
	}

	# Chỉ nén JSON; không nén response chứa token (BREACH) và luồng SSE.
	@compress not path /api/users/auth/* /api/agent/* /api/notifications/stream
	encode @compress {
		gzip 5
		minimum_length 1024
		match header Content-Type application/json*
	}

	@catalog path /api/contracts/reference-catalog
	request_body @catalog {
		max_size 11MiB
	}
	@not_catalog not path /api/contracts/reference-catalog
	request_body @not_catalog {
		max_size 10MiB
	}

	# Callback của OnlyOffice chỉ gọi trong mạng Docker, không mở ra ngoài.
	@office_internal path /api/procedures/office /api/procedures/office/*
	handle @office_internal {
		respond 404
	}

	@preflight method OPTIONS
	handle @preflight {
		header Access-Control-Max-Age "7200"
		respond 204
	}

	handle / {
		header Content-Type application/json
		respond `{"status":"ok","service":"gateway"}` 200
	}

	import api agent agent agent-service
	import api users users user-service
	import api lawyers lawyers lawyer-service
	import api procedures procedures procedure-service
	import api rag rag rag-service
	import api contracts contracts contract-service
	import api locations locations location-service
	import api consultations consultations consultation-service
	import api notifications notifications notification-service
	import api reports reports notification-service
	import api admin_reports admin/reports notification-service
	import api admin_broadcasts admin/broadcasts notification-service

	# document-service khai route gốc là "/api/v1/documents/" (có "/" cuối) nên làm ngược lại các service khác.
	@documents path /api/documents /api/documents/*
	handle @documents {
		uri path_regexp ^/api/documents$ /api/documents/
		uri path_regexp ^/api/ /api/v1/
		import upstream document-service
	}

	handle /ws/consultations/* {
		uri path_regexp ^/ws/ /ws/v1/
		import upstream consultation-service
	}

	handle {
		respond 404
	}
}

# OnlyOffice cần cổng hoặc tên miền riêng: procedure-service chỉ nhận đường dẫn lưu file bắt đầu bằng /cache/.
# Không bật profile full thì địa chỉ này trả 502.
{$OFFICE_SITE_ADDRESS:https://localhost:8443} {
	reverse_proxy onlyoffice:80
}
