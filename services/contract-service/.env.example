# contract-service: biến cho docker-compose.ec2.yml. Copy thành .env cùng thư mục rồi điền (KHÔNG commit .env).
# JWT_*_KEY_PATH, RABBITMQ_* và *_SERVICE_URL đã đặt sẵn trong docker-compose.ec2.yml.
# Dòng bắt đầu bằng # là tuỳ chọn; giá trị chứa dấu $ thì bọc trong nháy đơn.
# Máy chủ ngoài localhost bắt buộc kết thúc bằng ?sslmode=require, thiếu thì contract-worker không khởi động
CONTRACT_DATABASE_URL=
PROCEDURE_DATABASE_URL=
CONTRACT_SUPABASE_URL=
CONTRACT_SUPABASE_SERVICE_ROLE_KEY=
CONTRACT_STORAGE_BUCKET=contract-files
CONTRACT_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
INTERNAL_TOKEN=
# CONTRACT_DB_POOL_SIZE=4
