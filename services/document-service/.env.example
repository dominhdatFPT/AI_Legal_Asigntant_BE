# document-service: biến cho docker-compose.ec2.yml. Copy thành .env cùng thư mục rồi điền (KHÔNG commit .env).
# JWT_*_KEY_PATH, RABBITMQ_* và *_SERVICE_URL đã đặt sẵn trong docker-compose.ec2.yml.
# Dòng bắt đầu bằng # là tuỳ chọn; giá trị chứa dấu $ thì bọc trong nháy đơn.
DOCUMENT_DATABASE_URL=
# DOCUMENT_DATABASE_POOLER_HOST=
DOCUMENT_SUPABASE_URL=
DOCUMENT_SUPABASE_SERVICE_ROLE_KEY=
DOCUMENT_STORAGE_BUCKET=document-files
DOCUMENT_HTTP_TIMEOUT_SECONDS=20
DOCUMENT_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DOCUMENT_OCR_CPU_THREADS=2
# VietOCR đã tắt trong docker-compose.ec2.yml. Đọc CCCD bằng VNPT (Tesseract dự phòng): đặt EKYC_ENABLED=1 và đủ 3 token
EKYC_ENABLED=0
# EKYC_ACCESS_TOKEN=
# EKYC_TOKEN_ID=
# EKYC_TOKEN=
INTERNAL_TOKEN=
