// Thiết kế 08/10/2026. Chưa tạo bảng hoặc triển khai upload/OCR.
// owner_user_id tham chiếu logic User, không FK xuyên database.
Enum document_purpose {
  contract_template
  supporting_document
}
Enum document_type {
  contract
  identity_card
  other
}
Enum document_file_status {
  pending_check
  available
  rejected
}
Enum document_job_status {
  queued
  processing
  completed
  failed
}
Enum document_source_kind {
  docx
  pdf_text
  pdf_scan
  pdf_mixed
  image
}
Enum identity_profile_status {
  active
  deleted
}

Table user_files {
  id uuid [pk]
  owner_user_id uuid [not null, note: 'Lấy từ JWT sub; admin không tự có quyền xem giấy tờ user.']
  purpose document_purpose [not null]
  document_type document_type [not null, note: 'User khai báo loại; OCR không tự ghi đè hay coi là đã xác minh.']
  original_filename varchar(255) [not null, note: 'Chỉ hiển thị, không dùng làm tên/path storage.']
  media_type varchar(150) [not null, note: 'MIME kiểm tra từ nội dung, không tin Content-Type của client.']
  uploaded_size_bytes bigint [not null]
  uploaded_sha256 varchar(64) [not null, note: 'Hash bytes đầu vào, dùng fingerprint idempotency; không giữ ảnh EXIF gốc.']
  size_bytes bigint [note: 'Số bytes bản an toàn sẽ trả từ /content; có thể khác ảnh đầu vào sau bỏ EXIF.']
  sha256 varchar(64) [note: 'Hash bytes tại /content, chỉ có khi available.']
  storage_key text [not null, unique, note: 'Object private, quarantine trước khi kiểm tra xong. Không trả key/URL công khai trong metadata.']
  file_status document_file_status [not null, default: 'pending_check']
  error_code varchar(100)
  idempotency_key uuid [not null]
  request_hash varchar(64) [not null, note: 'Hash purpose/type/filename/hash bytes upload; không log nội dung.']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz
  indexes {
    (owner_user_id, idempotency_key) [unique]
    (owner_user_id, created_at)
  }
  Note: 'SQL CHECK: upload 1..9437184 bytes (9 MiB); contract_template có type=contract và MIME DOCX/PDF; identity_card chỉ supporting_document. available phải có size/hash an toàn và error_code NULL. Bản available bất biến: không thay bytes/purpose/type. Upload lại tạo ID mới. Metadata + queued job cùng transaction sau ghi object; dọn object orphan nếu transaction fail. Xóa mềm, không cascade DB Contract. File đang là nguồn identity profile active không được xóa: unlink/thay profile trước, cùng transaction kiểm tra chống race.'
}

Table document_processing_jobs {
  id uuid [pk]
  document_id uuid [not null]
  attempt integer [not null, default: 1, note: 'Số lần xử lý server cấp dưới khóa file. API chưa có retry thủ công.']
  status document_job_status [not null, default: 'queued']
  retry_count integer [not null, default: 0, note: 'Retry lỗi tạm cùng job có giới hạn; không xử lý đồng thời cùng file.']
  error_code varchar(100)
  created_at timestamptz [not null, default: `now()`]
  started_at timestamptz
  completed_at timestamptz
  updated_at timestamptz [not null, default: `now()`]
  indexes {
    (document_id, attempt) [unique]
    (status, created_at)
  }
  Note: 'SQL CHECK attempt>=1, retry_count>=0; terminal completed/failed phải có completed_at, failed phải có error_code. Partial UNIQUE(document_id) WHERE status IN (queued,processing). Worker kiểm tra/quét file, bỏ EXIF ảnh rồi extract/OCR; available không có nghĩa OCR completed. Lỗi OCR giữ file available; phát hiện file nguy hiểm thì rejected. Result + completed job cùng transaction. DELETE active trả 409 dưới khóa file.'
}

Table document_extraction_results {
  id uuid [pk]
  job_id uuid [not null, unique]
  schema_version varchar(20) [not null, default: '1.0']
  source_sha256 varchar(64) [not null]
  source_kind document_source_kind [not null]
  text text [not null, default: '']
  pages jsonb [not null, default: `'[]'::jsonb`, note: 'PDF/ảnh: page, width/height pt, rotation, blocks text + bbox top-left 0..1 sau crop/rotation + confidence. DOCX pages=[]; Contract tự parse file gốc.']
  extracted_fields jsonb [not null, default: `'[]'::jsonb`, note: 'Gợi ý key/value/confidence/source_page/source_bbox; tất cả đều cần user review. Không tự xác minh CCCD hoặc ánh xạ bên A/B.']
  warnings jsonb [not null, default: `'[]'::jsonb`]
  engine_version varchar(100) [not null]
  created_at timestamptz [not null, default: `now()`]
  Note: 'Mỗi completed job đúng một result bất biến. Hash khớp bản available. GET extraction chỉ trả result của attempt mới nhất completed; không âm thầm dùng result cũ. Chữ/vị trí OCR không chắc có warnings; không tự bịa giá trị. Không log PII, token hoặc signed URL.'
}

Ref: user_files.id < document_processing_jobs.document_id
Ref: document_processing_jobs.id - document_extraction_results.job_id

// Profile dùng lại từ trang detail user, không lấy raw OCR trực tiếp để tự điền.
Table user_identity_profiles {
  owner_user_id uuid [pk, note: 'Một profile hiện tại/user, lấy từ JWT; không FK User DB.']
  source_document_id uuid [note: 'Nullable khi dùng session; cùng source_result_id có giá trị cho luồng file cũ.']
  source_result_id uuid
  source_session_id uuid [note: 'T4 completed cùng owner; XOR với document+result, migration 004.']
  revision integer [not null, default: 1]
  status identity_profile_status [not null, default: 'active']
  full_name varchar(200)
  date_of_birth date
  identity_number varchar(12) [note: 'Chuỗi giữ số 0 đầu; không unique toàn hệ thống, không dùng xác minh danh tính.']
  issue_date date
  issue_place varchar(500)
  permanent_address text
  confirmed_at timestamptz [not null, note: 'User kiểm tra/sửa và xác nhận dữ liệu OCR; không phải KYC.']
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz
  Note: 'Nguồn session completed cùng owner XOR với legacy supporting_document/identity_card JPEG/PNG/PDF available + latest completed/hash. Owner advisory -> nguồn cũ/mới -> profile, CAS revision. PUT expected_revision=0 chỉ khi chưa từng có row; revision tăng cả unlink/recreate. DELETE204 không body; GET404 có current_revision, không reset. Sáu field review, thiếu NULL; active có ít nhất1 field. Unlink không purge; FK giữ nguồn. Đổi profile không sửa nháp/hợp đồng cũ, không sao chép DB User hoặc xác minh KYC.'
}

Ref: user_files.id < user_identity_profiles.source_document_id
Ref: document_extraction_results.id < user_identity_profiles.source_result_id

Table document_identity_ocr_sessions {
  id uuid [pk]
  owner_user_id uuid [not null]
  idempotency_key uuid [not null]
  request_hash varchar(64) [not null]
  status text [not null, default: 'processing']
  front_storage_key text [not null, unique]
  back_storage_key text [not null, unique]
  front_sha256 varchar(64) [not null]
  back_sha256 varchar(64) [not null]
  front_size_bytes integer [not null]
  back_size_bytes integer [not null]
  raw_front jsonb
  raw_back jsonb
  fields jsonb
  warnings jsonb [not null]
  verification_status text [not null, default: 'not_performed']
  error_code text
  error_status integer
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  indexes {
    (owner_user_id, idempotency_key) [unique]
  }
  Note: 'RLS/backend-only. 003: processing/completed/failed; private JPEG hai mặt và JSON engine. 004: owner/source bất biến, completed/failed bất biến. OCR không phải KYC; không tự tạo profile. Giới hạn ảnh/JSON và storage-key owner/session theo CHECK SQL.'
}
Ref: document_identity_ocr_sessions.id < user_identity_profiles.source_session_id

Table document_notification_outbox {
  event_id uuid [pk, default: `gen_random_uuid()`]
  job_id uuid [not null, unique]
  document_id uuid [not null]
  recipient_user_id uuid [not null]
  event_type text [not null]
  occurred_at timestamptz [not null]
  status text [not null, default: 'pending']
  attempts integer [not null, default: 0]
  next_attempt_at timestamptz [not null, default: `now()`]
  last_error_code text
  sent_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  Note: '005: terminal job enqueues in same transaction; no historical backfill. One immutable event/job, owner recipient, payload empty. Pending/sent/failed, attempts0..12, sent iff sent_at present. RLS/browser revoke; service_role SELECT/UPDATE only, trigger SECURITY DEFINER inserts. Session dispatcher lock/retry, no cross-service FK or purge.'
}
Ref: document_processing_jobs.id - document_notification_outbox.job_id
Ref: user_files.id < document_notification_outbox.document_id

Table document_lawyer_card_ocr {
  id uuid [pk]
  owner_user_id uuid [not null]
  idempotency_key uuid [not null]
  request_hash varchar(64) [not null]
  status text [not null, default: 'processing']
  storage_key text [not null, unique]
  sha256 varchar(64) [not null]
  size_bytes integer [not null]
  engine text [not null]
  raw jsonb
  fields jsonb
  warnings jsonb [not null]
  error_code text
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  indexes {
    (owner_user_id, idempotency_key) [unique]
  }
  Note: '006 (Luật sư): một ảnh thẻ luật sư/dòng. JPEG mã hóa lại, private safe/<owner>/lawyer-card/<id>.jpg. OCR lỗi vẫn giữ dòng (failed) để người dùng nhập tay. Lawyer Service chỉ lưu id + JSON OCR qua API nội bộ. RLS/backend-only, không FK sang User.'
}
