# Dockerfile cho Render: build context = thư mục gốc repo.
# Lưu ý: image có torch + VietOCR + Tesseract, cần >= 2 GB RAM (gói free 512 MB không chạy nổi).
FROM python:3.11-slim
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends tesseract-ocr tesseract-ocr-vie tesseract-ocr-eng fonts-dejavu-core && rm -rf /var/lib/apt/lists/*
COPY libs/common_auth /libs/common_auth
RUN pip install --no-cache-dir /libs/common_auth
COPY services/document-service/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY services/document-service/requirements-vietocr.txt .
RUN pip install --no-cache-dir torch==2.7.1 torchvision==0.22.1 --index-url https://download.pytorch.org/whl/cpu && pip install --no-cache-dir -r requirements-vietocr.txt && pip install --no-cache-dir --no-deps vietocr==0.3.13
COPY services/document-service/scripts/download_vietocr_model.py /app/scripts/download_vietocr_model.py
RUN python /app/scripts/download_vietocr_model.py
COPY services/document-service/app ./app
COPY services/document-service/scripts/check_local_ocr*.py /app/scripts/
COPY services/document-service/scripts/setup_identity_profile.py services/document-service/scripts/setup_document_outbox.py services/document-service/scripts/check_release.py /app/scripts/
CMD ["sh", "-c", "exec uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000} --proxy-headers --forwarded-allow-ips='*'"]
