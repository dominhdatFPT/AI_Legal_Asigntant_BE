# notification-service: biến cho docker-compose.ec2.yml. Copy thành .env cùng thư mục rồi điền (KHÔNG commit .env).
# JWT_*_KEY_PATH, RABBITMQ_* và *_SERVICE_URL đã đặt sẵn trong docker-compose.ec2.yml.
# Dòng bắt đầu bằng # là tuỳ chọn; giá trị chứa dấu $ thì bọc trong nháy đơn.
# Để trống = SQLite trong volume notification_data
NOTIFICATION_DATABASE_URL=
