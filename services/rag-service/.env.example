# Chỉ dùng khi chạy riêng rag-service bằng uvicorn trong thư mục này.
# Chạy bằng Docker / script thì biến lấy từ file .env ở thư mục gốc.

# ── JWT ───────────────────────────────────────────────────────────────────────
# Đường dẫn tới public key dùng để verify JWT từ user-service
JWT_PUBLIC_KEY_PATH=keys/jwt_public.pem

# ── Internal token ────────────────────────────────────────────────────────────
# Phải khớp với INTERNAL_TOKEN bên agent-service
INTERNAL_TOKEN=change-me-to-a-long-random-string

# ── Database (Supabase → Project Settings → Database → Connection string) ────
RAG_DATABASE_URL=postgresql://user:password@localhost:5432/rag_db
# Chống treo khi kết nối DB chết ngầm (giây, 0 = bỏ giới hạn): chờ tối đa khi mở kết nối mới / cho một truy vấn,
# và tuổi tối đa của kết nối trong pool. Truy vấn quá giờ thì rag trả 503 nhanh thay vì treo.
# Chạy script nạp văn bản (ingest) mà có câu SQL lâu hơn DB_COMMAND_TIMEOUT_SECONDS thì đặt 0.
DB_CONNECT_TIMEOUT_SECONDS=10
DB_COMMAND_TIMEOUT_SECONDS=20
DB_POOL_RECYCLE_SECONDS=300

# ── Embedding ─────────────────────────────────────────────────────────────────
# gemini: gọi Gemini API (gói free) | fake: vector giả, không cần key, chỉ để thử
EMBEDDING_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key
EMBEDDING_MODEL=gemini-embedding-001
# Phải khớp vector(768) trong database/001_rag_schema.sql
EMBEDDING_DIM=768
EMBEDDING_BATCH_SIZE=20
