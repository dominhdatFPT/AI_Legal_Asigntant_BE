# Dockerfile cho Render: build context = thư mục gốc repo (Render không hỗ trợ additional_contexts của docker-compose).
# Local vẫn dùng Dockerfile thường qua docker-compose.
FROM python:3.11-slim
WORKDIR /app
COPY libs/common_auth /libs/common_auth
RUN pip install --no-cache-dir /libs/common_auth
COPY services/location-service/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY services/location-service/app ./app
# Render cấp cổng qua biến PORT; chạy local không có PORT thì dùng 8000.
CMD ["sh", "-c", "exec uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000} --proxy-headers --forwarded-allow-ips='*'"]
