# lawyer-service: biến cho docker-compose.ec2.yml. Copy thành .env cùng thư mục rồi điền (KHÔNG commit .env).
# JWT_*_KEY_PATH, RABBITMQ_* và *_SERVICE_URL đã đặt sẵn trong docker-compose.ec2.yml.
# Dòng bắt đầu bằng # là tuỳ chọn; giá trị chứa dấu $ thì bọc trong nháy đơn.
LAWYER_DATABASE_URL=
INTERNAL_TOKEN=
LAWYER_SERVICE_TOKEN=
LAWYER_REAPPLY_COOLDOWN_HOURS=24
