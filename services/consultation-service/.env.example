# consultation-service: biến cho docker-compose.ec2.yml. Copy thành .env cùng thư mục rồi điền (KHÔNG commit .env).
# JWT_*_KEY_PATH, RABBITMQ_* và *_SERVICE_URL đã đặt sẵn trong docker-compose.ec2.yml.
# Dòng bắt đầu bằng # là tuỳ chọn; giá trị chứa dấu $ thì bọc trong nháy đơn.
CONSULTATION_DATABASE_URL=
INTERNAL_TOKEN=
# Đổi giá trị thì mọi user phải đồng ý điều khoản lại
CONSULTATION_TERMS_VERSION=2026-11-01
# Nhớ trạng thái tài khoản bao lâu (giây, 0 = hỏi user-service mỗi lần)
USER_ACTIVE_CACHE_SECONDS=30
# Origin FE được mở WebSocket bằng cookie
CONSULTATION_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
