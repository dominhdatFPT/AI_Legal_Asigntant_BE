# ── JWT ───────────────────────────────────────────────────────────────────────
# Đường dẫn tới public key dùng để verify JWT từ user-service
# Chọn 1 trong 2 cách cấu hình:
JWT_PUBLIC_KEY_PATH=keys/jwt_public.pem
# JWT_KEYS_DIR=keys

# ── Internal token ────────────────────────────────────────────────────────────
# Phải khớp với INTERNAL_TOKEN bên rag-service
INTERNAL_TOKEN=change-me-to-a-long-random-string

# ── Downstream services ───────────────────────────────────────────────────────
RAG_SERVICE_URL=http://rag-service:8000
PROCEDURE_SERVICE_URL=http://procedure-service:8000

# ── Database ──────────────────────────────────────────────────────────────────
AGENT_DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/agent_db

# ── LLM (Gemini) ──────────────────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash
# Chờ tối đa mỗi lần gọi (giây) và số lần thử lại khi Gemini quá tải
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MAX_RETRIES=2
