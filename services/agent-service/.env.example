# Chỉ dùng khi chạy riêng agent-service bằng uvicorn trong thư mục này.
# Chạy bằng Docker thì biến lấy từ file .env ở thư mục gốc (xem README-AGENT.md, mục 7).

# ── JWT ───────────────────────────────────────────────────────────────────────
# Đường dẫn tới public key dùng để verify JWT từ user-service
# Chọn 1 trong 2 cách cấu hình:
JWT_PUBLIC_KEY_PATH=keys/jwt_public.pem
# JWT_KEYS_DIR=keys

# ── Internal token ────────────────────────────────────────────────────────────
# Phải khớp với INTERNAL_TOKEN bên rag-service
INTERNAL_TOKEN=change-me-to-a-long-random-string

# ── Downstream services ───────────────────────────────────────────────────────
RAG_SERVICE_URL=http://rag-service:8000
PROCEDURE_SERVICE_URL=http://procedure-service:8000
# Lấy chữ tài liệu người dùng đính kèm khi hỏi (gọi bằng access token của người dùng)
DOCUMENT_SERVICE_URL=http://document-service:8000

# ── Database ──────────────────────────────────────────────────────────────────
# Chuỗi kết nối Supabase. Dùng đầu postgresql:// (code tự đổi sang driver psycopg),
# KHÔNG dùng postgresql+asyncpg://
AGENT_DATABASE_URL=postgresql://user:password@localhost:5432/agent_db

# ── LLM ───────────────────────────────────────────────────────────────────────
# Một provider (openrouter | groq | gemini) hoặc danh sách ưu tiên cách nhau dấu phẩy: provider đầu lỗi thì thử provider kế tiếp
LLM_PROVIDER=openrouter,gemini

GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=qwen/qwen3.8-27b
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.1-flash-lite

# Chờ tối đa mỗi lần gọi (giây) và số lần thử lại khi lỗi tạm thời (429/500/503/504, timeout)
GROQ_TIMEOUT_SECONDS=15
GROQ_MAX_RETRIES=1
GEMINI_TIMEOUT_SECONDS=45
GEMINI_MAX_RETRIES=3

# ── LLM (OpenRouter, API tương thích OpenAI) ──────────────────────────────────
# Khóa lấy tại https://openrouter.ai/keys (KHÔNG commit khóa thật)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Ví dụ model free: recursive/flint-v1.0:free
OPENROUTER_MODEL=
# Tuỳ chọn: hiện tên ứng dụng trên bảng xếp hạng OpenRouter (header HTTP-Referer / X-Title)
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=
# Token chừa cho phần "suy nghĩ" của câu trả lời chính. Mặc định 0 = không gửi tham số reasoning, hợp với model không bắt buộc
# suy nghĩ như Gemini. Model suy luận bắt buộc (vd recursive/flint-v1.0:free) cần đặt lại khoảng 1024, để 0 thì câu trả lời có thể
# bị cắt hoặc rỗng
OPENROUTER_REASONING_MAX_TOKENS=0
# Mức suy luận riêng cho lượt gọi phụ chỉ trả JSON ngắn, hiện là lượt chấm liên quan (RELEVANCE_CHECK).
# 0 = tắt suy luận (chấm từ ~5s còn ~1s); số dương = chừa chừng đó token cho model bắt buộc suy luận
LLM_AUX_REASONING_MAX_TOKENS=0
# Model OpenRouter riêng cho lượt gọi phụ (chấm liên quan, viết lại câu hỏi), thường là bản nhẹ hơn cùng họ với OPENROUTER_MODEL.
# Rỗng = lượt phụ dùng OPENROUTER_MODEL. Chỉ tác dụng với provider openrouter. Đo lại bước chấm (scripts/eval_relevance.py) trước khi dùng thật.
OPENROUTER_AUX_MODEL=

# Giới hạn độ dài câu trả lời (token): hỏi đáp thường / rà soát tài liệu đính kèm
LLM_MAX_OUTPUT_TOKENS=800
LLM_REVIEW_MAX_OUTPUT_TOKENS=2000
# Chờ tối đa mỗi provider khi rà soát (giây). Rà soát không thử lại cùng provider
LLM_REVIEW_TIMEOUT_SECONDS=40

# Chỉ để test, KHÔNG bật ở môi trường thật: true = bỏ bước LLM, trả thẳng các đoạn luật rag tìm được
LLM_BYPASS=false

# true = trước khi trả lời, nhờ LLM chấm xem các đoạn luật tìm được có liên quan không; không liên quan thì trả câu "ngoài phạm vi".
# Mỗi câu hỏi tốn thêm một lượt gọi LLM ngắn (chờ tối đa RELEVANCE_TIMEOUT_SECONDS giây, quá giờ thì bỏ qua bước chấm)
RELEVANCE_CHECK=false
RELEVANCE_TIMEOUT_SECONDS=8
# Số ký tự đầu của mỗi đoạn luật mà bước chấm liên quan được đọc (đoạn luật dài tới ~2500 ký tự). Tăng thì prompt chấm dài và chậm hơn
RELEVANCE_CHUNK_CHARS=600

# true = viết lại câu hỏi thành một câu tìm kiếm dùng thuật ngữ luật (nhờ LLM) trước khi tìm trong rag-service. Mỗi câu hỏi tốn thêm
# một lượt gọi LLM ngắn (chờ tối đa QUERY_REWRITE_TIMEOUT_SECONDS giây, lỗi hoặc quá giờ thì dùng câu gốc)
QUERY_REWRITE_ENABLED=false
QUERY_REWRITE_TIMEOUT_SECONDS=5

# true = tài liệu đính kèm quá ít chữ hoặc chữ rác (OCR hỏng) thì agent trả lời ngay, không tìm luật và không gọi LLM
# DOCUMENT_MIN_CHARS: số ký tự tối thiểu; DOCUMENT_MIN_VALID_RATIO: tỷ lệ tối thiểu các từ là âm tiết tiếng Việt hợp lệ
DOCUMENT_GATE_ENABLED=false
DOCUMENT_MIN_CHARS=200
DOCUMENT_MIN_VALID_RATIO=0.5

# true = agent tự đếm chỗ trống ("......") và kiểm tra tài liệu có bị cắt vì quá dài không, đưa kết quả vào prompt rà soát
# để AI nêu lại cho người dùng. DOCUMENT_PLACEHOLDER_MIN: từ chừng này chỗ trống trở lên thì coi là mẫu chưa điền
DOCUMENT_FACTS_ENABLED=false
DOCUMENT_PLACEHOLDER_MIN=5

# true = không nhận ra loại hợp đồng mà câu hỏi chung chung ("kiểm tra giúp tôi") thì agent hỏi lại người dùng loại hợp đồng
# hoặc điều cần kiểm tra, không tìm luật và không gọi LLM. Câu hỏi cụ thể hoặc loại nhận ra được thì rà soát như cũ
DOCUMENT_ASK_TYPE_ENABLED=false

# true = agent kiểm bằng từ khoá các mục thường gặp của hợp đồng (bên, giá, thời hạn, quyền nghĩa vụ, vi phạm, tranh chấp, chữ ký)
# và đưa mục chưa thấy từ khoá vào prompt rà soát như dữ kiện cho AI nêu lại. Không khẳng định "thiếu", không gọi thêm LLM
DOCUMENT_CHECKLIST_ENABLED=false

# ── RAG ───────────────────────────────────────────────────────────────────────
# Số đoạn luật lấy từ rag-service cho mỗi câu tìm
RAG_TOP_K=3
# Tìm 2 bước (cần RELEVANCE_CHECK=true, LLM_BYPASS=false): lấy RAG_CANDIDATE_K đoạn luật làm ứng viên (lớn hơn RAG_TOP_K, tối đa 20)
# rồi AI chấm chọn đoạn dùng được, giữ tối đa RAG_SELECT_MAX đoạn. RAG_CANDIDATE_K=0 là tắt. Không thêm lượt gọi LLM
RAG_CANDIDATE_K=0
RAG_SELECT_MAX=5
# true = cache kết quả tìm luật trong bộ nhớ agent-service: cùng câu tìm (không phân biệt hoa thường, khoảng trắng, dấu ? . ! ở cuối) và
# cùng RAG_TOP_K thì lấy lại, khỏi tốn một lượt embedding Gemini ở rag-service. Cache theo từng process, mất khi restart.
# Nạp luật mới xong phải restart agent-service để xoá cache (không thì tới hết TTL vẫn trả đoạn cũ).
RAG_CACHE_ENABLED=false
RAG_CACHE_TTL_SECONDS=86400
RAG_CACHE_MAX_ITEMS=1000
# true = cache câu trả lời cuối trong bộ nhớ agent-service: CHỈ câu đầu hội thoại (không có lịch sử), không kèm tài liệu, LLM_BYPASS tắt,
# và chỉ khớp khi giống hệt sau chuẩn hoá (không phân biệt hoa thường, khoảng trắng, dấu ? . ! ở cuối). Trúng thì không gọi rag và AI.
# Cache theo từng process, mất khi restart. Đổi prompt hoặc model thì restart để xoá.
ANSWER_CACHE_ENABLED=false
ANSWER_CACHE_TTL_SECONDS=21600
ANSWER_CACHE_MAX_ITEMS=500
