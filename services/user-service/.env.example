# user-service: biến cho docker-compose.ec2.yml. Copy thành .env cùng thư mục rồi điền (KHÔNG commit .env).
# JWT_*_KEY_PATH, RABBITMQ_*, REDIS_URL, OUTBOX_ENABLED, RUN_* và *_SERVICE_URL đã đặt sẵn trong docker-compose.ec2.yml.
# Dòng bắt đầu bằng # là tuỳ chọn; giá trị chứa dấu $ thì bọc trong nháy đơn.
USER_DATABASE_URL=
INTERNAL_TOKEN=
# Bắt buộc cho luồng duyệt luật sư, giống giá trị ở lawyer-service
LAWYER_SERVICE_TOKEN=
FIREBASE_PROJECT_ID=
FIREBASE_CLOCK_SKEW_SECONDS=10
# Sau Caddy luôn là HTTPS. FE khác domain thì SAMESITE=none
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=none
# AUTH_COOKIE_DOMAIN=
AUTH_REFRESH_COOKIE_PATH=/api/users/auth
# Origin được phép gọi login/refresh/logout bằng cookie (chống CSRF): thêm domain frontend khi deploy
AUTH_BROWSER_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# REQUIRE_EMAIL_VERIFICATION=false
