# procedure-service: biến cho docker-compose.ec2.yml. Copy thành .env cùng thư mục rồi điền (KHÔNG commit .env).
# JWT_*_KEY_PATH, RABBITMQ_* và *_SERVICE_URL đã đặt sẵn trong docker-compose.ec2.yml.
# Dòng bắt đầu bằng # là tuỳ chọn; giá trị chứa dấu $ thì bọc trong nháy đơn.
PROCEDURE_DATABASE_URL=
# DB của contract-service, dùng cho kho mẫu hợp đồng tham chiếu
CONTRACT_DATABASE_URL=
INTERNAL_TOKEN=
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
ENVIRONMENT=production
ALLOW_DEV_AUTH=false
# Biến ONLYOFFICE_* do docker-compose.ec2.yml đặt (profile full, giá trị lấy từ .env gốc)
