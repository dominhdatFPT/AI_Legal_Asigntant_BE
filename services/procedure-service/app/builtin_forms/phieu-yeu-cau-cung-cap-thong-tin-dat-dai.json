              "type": "checkbox",
              "required": false
            },
            {
              "key": "cadastral_map",
              "label": "Trích lục bản đồ địa chính thửa đất",
              "word_key": "data_cadastral_map",
              "type": "checkbox",
              "required": false
            },
            {
              "key": "land_history",
              "label": "Lịch sử biến động quyền sử dụng đất, tình trạng thế chấp",
              "word_key": "data_land_history",
              "type": "checkbox",
              "required": false
            },
            {
              "key": "purpose",
              "label": "Mục đích sử dụng dữ liệu",
              "word_key": "data_purpose",
              "type": "textarea",
              "required": true
            },
            {
              "key": "result_method",
              "label": "Hình thức nhận kết quả",
              "word_key": "result_method",
              "type": "select",
              "required": true,
              "help_text": "Chọn một hình thức nhận kết quả.",
              "options": [
                "Nhận trực tiếp",
                "Qua cổng dịch vụ công trực tuyến"
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "closing",
      "title": "Ngày lập phiếu và người ký",
      "order": 3,
      "blocks": [
        {
          "id": "closing_info",
          "instance_id": "closing_info",
          "block_key": "free_field",
          "title": "Người làm đơn",
          "order": 1,
          "fields": [
            {
              "key": "place",
              "label": "Địa điểm lập phiếu",
              "word_key": "signing_place",
              "type": "text",
              "required": true
            },
            {
              "key": "day",
              "label": "Ngày",
              "word_key": "signing_day",
              "type": "number",
              "required": true
            },
            {
              "key": "month",
              "label": "Tháng",
              "word_key": "signing_month",
              "type": "number",
              "required": true
            },
            {
              "key": "year",
              "label": "Năm",
              "word_key": "signing_year",
              "type": "number",
              "required": true
            },
            {
              "key": "person_signer",
              "label": "Họ tên người ký (cá nhân)",
              "word_key": "person_signer",
              "type": "text",
              "required": true,
              "autofill": "profile.full_name",
              "help_text": "Tự lấy từ hồ sơ CCCD; không thể sửa trong đơn.",
              "condition": {
                "field": "requester_info.requester_type",
                "equals": "Cá nhân"
              }
            },
            {
              "key": "organization_signer",
              "label": "Người đại diện ký tên (tổ chức)",
              "word_key": "organization_signer",
              "type": "text",
              "required": true,
              "condition": {
                "field": "requester_info.requester_type",
                "equals": "Tổ chức"
              }
            }
          ]
        }
      ]
    }
