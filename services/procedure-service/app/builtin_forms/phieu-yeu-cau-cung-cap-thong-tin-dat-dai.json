  "sections": [
    {
      "id": "requester",
      "title": "Thông tin tổ chức, cá nhân yêu cầu",
      "order": 1,
      "blocks": [
        {
          "id": "requester_info",
          "instance_id": "requester_info",
          "block_key": "free_field",
          "title": "Người yêu cầu",
          "order": 1,
          "fields": [
            {
              "key": "requester_type",
              "label": "Loại người yêu cầu",
              "word_key": "requester_type",
              "type": "select",
              "required": true,
              "help_text": "Chọn cá nhân hoặc tổ chức để hiện đúng nhóm thông tin.",
              "options": [
                "Cá nhân",
                "Tổ chức"
              ]
            },
            {
              "key": "person_name",
              "label": "Họ và tên cá nhân",
              "word_key": "person_name",
              "type": "text",
              "required": true,
              "autofill": "profile.full_name",
              "help_text": "Tự lấy từ hồ sơ CCCD; không thể sửa trong đơn.",
              "condition": {
                "field": "requester_info.requester_type",
                "equals": "Cá nhân"
              }
            },
            {
              "key": "person_identity",
              "label": "Số định danh cá nhân",
              "word_key": "person_identity",
              "type": "cccd",
              "required": true,
              "autofill": "profile.cccd_number",
              "help_text": "Tự lấy từ hồ sơ CCCD; không thể sửa trong đơn.",
              "condition": {
                "field": "requester_info.requester_type",
                "equals": "Cá nhân"
              }
            },
            {
              "key": "person_address",
              "label": "Địa chỉ cá nhân",
              "word_key": "person_address",
              "type": "textarea",
              "required": true,
              "autofill": "profile.permanent_address",
              "help_text": "Tự lấy địa chỉ thường trú; không thể sửa trong đơn.",
              "condition": {
                "field": "requester_info.requester_type",
                "equals": "Cá nhân"
              }
            },
            {
              "key": "organization_name",
              "label": "Tên tổ chức",
              "word_key": "organization_name",
              "type": "text",
              "required": true,
              "condition": {
                "field": "requester_info.requester_type",
                "equals": "Tổ chức"
              }
            },
            {
              "key": "organization_tax_code",
              "label": "Mã số thuế tổ chức",
              "word_key": "organization_tax_code",
              "type": "text",
              "required": true,
              "condition": {
                "field": "requester_info.requester_type",
                "equals": "Tổ chức"
              }
            },
            {
              "key": "organization_address",
              "label": "Địa chỉ trụ sở tổ chức",
              "word_key": "organization_address",
              "type": "textarea",
              "required": true,
              "condition": {
                "field": "requester_info.requester_type",
                "equals": "Tổ chức"
              }
            },
            {
              "key": "phone",
              "label": "Số điện thoại liên hệ",
              "word_key": "contact_phone",
              "type": "phone",
              "required": false,
              "autofill": "profile.phone",
              "help_text": "Tự điền từ hồ sơ cá nhân; có thể sửa cho đơn này."
            }
          ]
        }
      ]
    },
    {
