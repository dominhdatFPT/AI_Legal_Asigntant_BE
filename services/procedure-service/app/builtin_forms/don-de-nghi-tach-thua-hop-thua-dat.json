  "sections": [
    {
      "id": "applicant",
      "title": "I. Kê khai của người sử dụng đất",
      "order": 1,
      "blocks": [
        {
          "id": "applicant_info",
          "instance_id": "applicant_info",
          "block_key": "free_field",
          "title": "Người sử dụng đất",
          "order": 1,
          "fields": [
            {
              "key": "name",
              "label": "Họ và tên",
              "word_key": "applicant_name",
              "type": "text",
              "required": true,
              "autofill": "profile.full_name",
              "help_text": "Tự lấy từ hồ sơ CCCD; không thể sửa trong đơn."
            },
            {
              "key": "identity",
              "label": "Số CCCD / định danh cá nhân",
              "word_key": "applicant_identity",
              "type": "cccd",
              "required": true,
              "autofill": "profile.cccd_number",
              "help_text": "Tự lấy từ hồ sơ CCCD; không thể sửa trong đơn."
            },
            {
              "key": "address",
              "label": "Địa chỉ",
              "word_key": "applicant_address",
              "type": "textarea",
              "required": true,
              "autofill": "profile.permanent_address",
              "help_text": "Tự lấy địa chỉ thường trú; không thể sửa trong đơn."
            },
            {
              "key": "phone",
              "label": "Điện thoại liên hệ",
              "word_key": "phone",
              "type": "phone",
              "required": false,
              "autofill": "profile.phone"
            },
            {
              "key": "email",
              "label": "Hộp thư điện tử",
              "word_key": "email",
              "type": "email",
              "required": false,
              "autofill": "profile.email"
            }
          ]
        },
        {
          "id": "co_users",
          "instance_id": "co_users",
          "block_key": "repeat_group",
          "title": "Người cùng sử dụng đất (nếu có)",
          "order": 1,
          "fields": [
            {
              "key": "name",
              "label": "Họ tên người cùng sử dụng",
              "word_key": "co_user_name",
              "type": "text",
              "required": false
            },
            {
              "key": "identity",
              "label": "Số CCCD / định danh",
              "word_key": "co_user_identity",
              "type": "text",
              "required": false
            },
            {
              "key": "address",
              "label": "Địa chỉ",
              "word_key": "co_user_address",
              "type": "textarea",
              "required": false
            }
          ],
          "help_text": "Thêm một dòng cho mỗi người cùng sử dụng đất cần ký đơn."
        }
      ]
    },
    {
      "id": "operation",
      "title": "2. Đề nghị tách thửa, hợp thửa đất",
      "order": 2,
      "blocks": [
        {
          "id": "operation_info",
          "instance_id": "operation_info",
          "block_key": "free_field",
          "title": "Loại đề nghị và thông tin các thửa đất",
          "order": 1,
          "fields": [
            {
              "key": "operation_type",
              "label": "Nội dung đề nghị",
              "word_key": "operation_type",
              "type": "select",
              "required": true,
              "options": [
                "Tách thửa đất",
                "Hợp thửa đất",
                "Tách đồng thời với hợp thửa đất"
              ]
            },
            {
              "key": "combined_details",
              "label": "Mô tả chi tiết việc tách đồng thời với hợp thửa",
              "word_key": "combined_details",
              "type": "textarea",
              "required": true,
              "condition": {
                "field": "operation_info.operation_type",
                "equals": "Tách đồng thời với hợp thửa đất"
              }
            },
            {
              "key": "reason",
              "label": "Lý do tách / hợp thửa đất",
              "word_key": "operation_reason",
              "type": "textarea",
              "required": true
