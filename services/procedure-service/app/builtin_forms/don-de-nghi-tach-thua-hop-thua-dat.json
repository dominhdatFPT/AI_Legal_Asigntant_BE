            },
            {
              "key": "new_certificate_request",
              "label": "Đề nghị cấp Giấy chứng nhận (ghi có/không thay đổi người sử dụng đất)",
              "word_key": "new_certificate_request",
              "type": "select",
              "required": true,
              "options": [
                "Có thay đổi người sử dụng đất",
                "Không thay đổi người sử dụng đất"
              ]
            }
          ]
        },
        {
          "id": "parcels",
          "instance_id": "parcels",
          "block_key": "repeat_group",
