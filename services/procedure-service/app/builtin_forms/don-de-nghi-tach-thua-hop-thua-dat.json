                "Thửa đất mới sau hợp"
              ]
            },
            {
              "key": "parcel_number",
              "label": "Số thửa",
              "word_key": "parcel_number",
              "type": "text",
              "required": true
            },
            {
              "key": "map_sheet_number",
              "label": "Số tờ bản đồ",
              "word_key": "map_sheet_number",
              "type": "text",
              "required": true
            },
            {
              "key": "area",
              "label": "Diện tích (m²)",
              "word_key": "parcel_area",
              "type": "number",
              "required": true
            },
            {
              "key": "land_type",
              "label": "Loại đất",
              "word_key": "land_type",
              "type": "text",
              "required": true
            },
            {
              "key": "address",
              "label": "Địa chỉ thửa đất",
              "word_key": "parcel_address",
              "type": "textarea",
              "required": true
            },
            {
              "key": "certificate_number",
              "label": "Số vào sổ cấp GCN",
              "word_key": "certificate_number",
              "type": "text",
              "required": false
            },
            {
              "key": "certificate_issue_date",
              "label": "Ngày cấp GCN",
              "word_key": "certificate_issue_date",
              "type": "date",
              "required": false
            }
